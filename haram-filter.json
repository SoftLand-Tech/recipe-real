{
  "_comment": "Canonical haram (pork + alcohol) detection patterns for Recipe Real community content (user recipes, notes, posts, comments). Every pattern is applied case-insensitive with Unicode semantics. The alcohol patterns use negative lookaheads for vinegar forms (wine/sherry/beer vinegar are halal — the alcohol has been converted to acetic acid), and 'ham' uses word boundaries so hamburger/graham never match. The PHP port lives in backend/app/Support/HalalGate.php — keep the two in sync.",
  "patterns": [
    { "category": "pork", "term": "pork", "regex": "\\bpork\\b" },
    { "category": "pork", "term": "bacon", "regex": "\\bbacon\\b" },
    { "category": "pork", "term": "ham", "regex": "\\bham\\b" },
    { "category": "pork", "term": "pig", "regex": "\\bpigs?\\b" },
    { "category": "pork", "term": "lard", "regex": "\\blard\\b" },
    { "category": "pork", "term": "prosciutto", "regex": "\\bprosciutto\\b" },
    { "category": "pork", "term": "pancetta", "regex": "\\bpancetta\\b" },
    { "category": "pork", "term": "guanciale", "regex": "\\bguanciale\\b" },
    { "category": "pork", "term": "chorizo", "regex": "\\bchorizo\\b" },
    { "category": "pork", "term": "salami", "regex": "\\bsalami\\b" },
    { "category": "pork", "term": "pepperoni", "regex": "\\bpepperoni\\b" },
    { "category": "pork", "term": "chitterlings", "regex": "\\bchitterlings\\b" },
    { "category": "pork", "term": "chicharron", "regex": "\\bchicharron\\w*\\b" },
    { "category": "pork", "term": "capicola", "regex": "\\bcapicol\\w+\\b" },
    { "category": "alcohol", "term": "wine", "regex": "\\bwine(?![- ]vinegar)\\w*\\b" },
    { "category": "alcohol", "term": "sherry", "regex": "\\bsherry(?![- ]vinegar)\\w*\\b" },
    { "category": "alcohol", "term": "beer", "regex": "(?<!ginger )(?<!root )\\bbeers?\\b(?![- ]vinegar)" },
    { "category": "alcohol", "term": "whisky", "regex": "\\bwhisk(e)?y\\b" },
    { "category": "alcohol", "term": "bourbon", "regex": "\\bbourbon\\b" },
    { "category": "alcohol", "term": "rum", "regex": "\\brum\\b" },
    { "category": "alcohol", "term": "vodka", "regex": "\\bvodka\\b" },
    { "category": "alcohol", "term": "tequila", "regex": "\\btequila\\b" },
    { "category": "alcohol", "term": "gin", "regex": "\\bgin\\b" },
    { "category": "alcohol", "term": "brandy", "regex": "\\bbrand(y|ied)\\b" },
    { "category": "alcohol", "term": "cognac", "regex": "\\bcognac\\b" },
    { "category": "alcohol", "term": "champagne", "regex": "\\bchampagne\\b" },
    { "category": "alcohol", "term": "marsala", "regex": "\\bmarsala\\b" },
    { "category": "alcohol", "term": "madeira", "regex": "\\bmadeira\\b" },
    { "category": "alcohol", "term": "mirin", "regex": "\\bmirin\\b" },
    { "category": "alcohol", "term": "sake", "regex": "\\bsake\\b" },
    { "category": "alcohol", "term": "vermouth", "regex": "\\bvermouth\\b" },
    { "category": "alcohol", "term": "liqueur", "regex": "\\bliqueur\\w*\\b" },
    { "category": "alcohol", "term": "liquor", "regex": "\\bliquor\\b" },
    { "category": "alcohol", "term": "hard cider", "regex": "\\bhard cider\\b" }
  ]
}
