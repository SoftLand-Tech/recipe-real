APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Agy imports can run for up to ten minutes; keep the database lease longer.
DB_QUEUE_RETRY_AFTER=720

# AI recipe imports. The app stores a private draft, then the user/admin
# reviews it before the recipe is published. Set the endpoint/key when an AI
# provider is ready; supported protocols: generic, openai_compatible,
# anthropic, gemini.
RECIPE_IMPORTS_ENABLED=true
RECIPE_IMPORT_DISK=local
RECIPE_IMPORT_MAX_VIDEO_MB=100
RECIPE_IMPORT_MAX_IMAGE_MB=8
RECIPE_IMPORT_MAX_IMAGES=6
RECIPE_IMPORT_EXPIRES_HOURS=24
RECIPE_MEDIA_RESOLVER_URL=
RECIPE_MEDIA_RESOLVER_TOKEN=
RECIPE_MEDIA_RESOLVER_TIMEOUT=45
RECIPE_AI_PROVIDER=custom
RECIPE_AI_PROTOCOL=generic
RECIPE_AI_ENDPOINT=
RECIPE_AI_API_KEY=
RECIPE_AI_MODEL=
RECIPE_AI_TIMEOUT=180
RECIPE_AI_INLINE_MAX_BYTES=20971520

# Local agy worker. Set RECIPE_AI_PROVIDER=agy to run imports through the
# locally authenticated agy CLI instead of an HTTP provider. The queue worker
# must run as the same OS user that authenticated agy.
RECIPE_AI_CLI_BINARY=/home/mamoun/.local/bin/agy
RECIPE_AI_CLI_MODEL=gemini-3.8-flash-high
RECIPE_AI_CLI_EFFORT=high
RECIPE_AI_CLI_TIMEOUT=600
RECIPE_AI_CLI_PRINT_TIMEOUT=10m
RECIPE_AI_CLI_DANGEROUSLY_SKIP_PERMISSIONS=true
RECIPE_AI_CLI_WORKSPACE=/tmp/recipereal-ai-imports
RECIPE_AI_CLI_MAX_OUTPUT_BYTES=2097152

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Stripe / Laravel Cashier (Week-5 billing)
# ---------------------------------------------------------------------------
# Leave empty in dev to make billing endpoints return 503 "Billing not
# configured" instead of attempting live Stripe API calls.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

GOOGLE_CLIENT_ID=
# Optional separate admin callback. Leave blank to derive it from APP_URL.
GOOGLE_ADMIN_REDIRECT_URI=

# Sanctum: personal access token lifetime in minutes (43200 = 30 days).
SANCTUM_TOKEN_EXPIRATION=43200

# ---------------------------------------------------------------------------
# Admin panel (Filament /admin)
# ---------------------------------------------------------------------------
# Comma-separated emails allowed into the panel. Empty = nobody can log in.
# Password is set per-account with: php artisan recipereal:admin-password
ADMIN_EMAILS=owner@example.com

# ---------------------------------------------------------------------------
# Arabic translation pipeline (recipereal:translate-ar / MyMemory free API)
# ---------------------------------------------------------------------------
# Max source characters translated per run, across all rotate emails.
TRANSLATE_DAILY_BUDGET=140000
# Comma-separated contact emails — the free quota (~50k chars/day) is per
# email, so the command rotates through these as each one runs dry.
TRANSLATE_EMAILS=mamounprogrammer@gmail.com,imnotchoun@gmail.com,kohg60416@gmail.com

# ---------------------------------------------------------------------------
# Typesense search engine (bilingual EN/AR recipe search)
# ---------------------------------------------------------------------------
# Optional search backend running on the VPS loopback (127.0.0.1:8108 in
# prod). Leave TYPESENSE_API_KEY empty to DISABLE the feature entirely: all
# code paths no-op and search falls back to the SQLite FTS5 index (local dev
# has no daemon). After setting a key, build the index once with:
#   php artisan recipereal:reindex-typesense --fresh
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=
