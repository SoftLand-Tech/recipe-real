{
  "cli": {
    "version": ">= 3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "releaseChannel": "preview",
      "env": {
        "RECIPEREAL_API_BASE_URL": "https://recipe-real.softland.tech"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "releaseChannel": "production",
      "env": {
        "RECIPEREAL_API_BASE_URL": "https://recipe-real.softland.tech"
      }
    },
    "production-apk": {
      "distribution": "internal",
      "channel": "production",
      "releaseChannel": "production",
      "env": {
        "RECIPEREAL_API_BASE_URL": "https://recipe-real.softland.tech"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "store-apk": {
      "distribution": "internal",
      "channel": "production",
      "releaseChannel": "production",
      "env": {
        "RECIPEREAL_API_BASE_URL": "https://recipe-real.softland.tech"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
